---
// more = optional link on the right of the title, e.g. { href: '/community/', label: 'photos & videos' }
interface Props { title: string; id?: string; more?: { href: string; label: string } }
const { title, id, more } = Astro.props;
---

<table class="block"><tbody>
  <tr><td class="section-head">
    {more
      ? <div class="section-title-row"><h2 id={id}>{title}</h2><a class="section-more" href={more.href}>{more.label} &rarr;</a></div>
      : <h2 id={id}>{title}</h2>}
    <slot />
  </td></tr>
</tbody></table>
